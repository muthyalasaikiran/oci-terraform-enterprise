# Custom image OCID - replace all placeholder values before plan/apply.
region              = "ap-mumbai-1"
compartment_id      = "ocid1.compartment.oc1..REPLACE"
availability_domain = "REPLACE_WITH_EXACT_AD_NAME"
subnet_id           = "ocid1.subnet.oc1.ap-mumbai-1.REPLACE"
instance_name       = "msk-sample-from-custom-image"
shape               = "VM.Standard.E5.Flex"
shape_ocpus         = 1
shape_memory_gbs    = 8
source_id           = "ocid1.image.oc1.ap-mumbai-1.REPLACE"
ssh_public_key_path = "C:/Users/YOUR_USER/.ssh/id_rsa.pub"
assign_public_ip    = false
nsg_ids             = []
create_data_volume  = true
data_volume_name    = "msk-sample-from-custom-image-data"
data_volume_size_gb = 100
data_volume_vpus_per_gb = 10
tags = { project = "MSK_sample", managed_by = "terraform", environment = "uat" }
